
{
  "id": "magis-live",
  "name": "Magis Live TV",
  "version": "1.2.0",
  "description": "TV en vivo Magis (v6/getLiveData como Xuper). Categorías + canales. Seeds automáticas.",
  "author": "XuperTV",
  "entry": "plugin.js",
  "main": "plugin.js",
  "icon": "https://i.imgur.com/8Km9tLL.png",
  "categories": ["live", "tv", "iptv"],
  "capabilities": ["live", "home", "streams"],
  "languages": ["Español"],
  "types": ["channel", "live"],
  "apiVersion": 6,
  "tabs": ["live", "settings"],
  "theme": {
    "accent": "#1E88E5",
    "background": "#0B0B0F",
    "surface": "#16161D"
  },
  "config": [
    {
      "key": "hosts",
      "label": "Hosts Magis (separados por coma)",
      "type": "text",
      "default": "sqacjy.s5lm5aydc.xyz,osuhk.m3x8o50te.com"
    },
    {
      "key": "seedsUrl",
      "label": "URL de seeds (sesión automática)",
      "type": "text",
      "default": "https://raw.githubusercontent.com/xuper-plugin/kino-plugin-xuper/seeds/seeds.json"
    },
    {
      "key": "liveRoot",
      "label": "Código columna live",
      "type": "text",
      "default": "masnew_live"
    }
  ]
}
