{
  "id": "magis-live",
  "name": "Magis Live TV",
  "version": "1.1.0",
  "description": "TV en vivo Magis / Xuper. Solo requiere email y contraseña. Hosts y clave del portal van fijos en el código (igual que el lib original).",
  "author": "MagisLive",
  "logo": "https://i.imgur.com/8QKQqQq.png",
  "icon": "https://i.imgur.com/8QKQqQq.png",
  "banner": "",
  "types": [
    "live",
    "tv",
    "channel"
  ],
  "entry": "plugin.js",
  "resources": [
    "catalog",
    "meta",
    "stream"
  ],
  "idPrefixes": [
    "magis:"
  ],
  "config": [
    {
      "key": "email",
      "label": "Email / Usuario Magis",
      "type": "text",
      "required": true,
      "placeholder": "tu@email.com",
      "description": "Cuenta Magis/Xuper"
    },
    {
      "key": "password",
      "label": "Contraseña",
      "type": "password",
      "required": true,
      "placeholder": "••••••••",
      "description": "Se guarda solo en este dispositivo"
    }
  ],
  "theme": {
    "accent": "#E53935",
    "onAccent": "#FFFFFF",
    "background": "#0D0D0D",
    "surface": "#1A1A1A"
  },
  "categories": [
    "Live",
    "TV"
  ],
  "language": "es"
}
