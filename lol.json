{
  "id": "youtube-demo-structures",
  "name": "YouTube Demo",
  "version": "2.1.0",
  "description": "Demo movil completo: home, buscar (scroll), ficha con player estilo YouTube, biblioteca e historial, ajustes.",
  "author": "Nuvio Demo",
  "entry": "plugin.js",
  "icon": "https://www.youtube.com/s/desktop/yt_1200.png",
  "banner": "https://i.ytimg.com/vi/dQw4w9WgXcQ/maxresdefault.jpg",
  "hasCustomUi": true,
  "uiPlatforms": [
    "mobile"
  ],
  "capabilities": [
    "home",
    "search",
    "meta",
    "streams"
  ],
  "categories": [
    "movies",
    "music",
    "live",
    "mixed"
  ],
  "contentTypes": [
    "movies",
    "music",
    "live"
  ],
  "languages": [
    "es",
    "en"
  ],
  "theme": {
    "accent": "#FF0000",
    "background": "#0F0F0F",
    "surface": "#212121",
    "highlight": "#FF0000"
  },
  "config": [
    {
      "key": "api_key",
      "label": "YouTube Data API Key (opcional)",
      "type": "password",
      "description": "Si la pones se usa Data API v3. Si no, Innertube + Invidious/Piped.",
      "placeholder": "AIza...",
      "required": false
    },
    {
      "key": "region_code",
      "label": "Región",
      "type": "select",
      "defaultValue": "MX",
      "options": [
        "MX",
        "ES",
        "AR",
        "CO",
        "CL",
        "US",
        "BR"
      ],
      "description": "Código de país para tendencias y búsquedas"
    },
    {
      "key": "preferred_lang",
      "label": "Idioma preferido",
      "type": "select",
      "defaultValue": "es",
      "options": [
        "es",
        "en",
        "pt"
      ],
      "description": "Idioma de la interfaz de YouTube (hl)"
    }
  ]
}
