{
  "id": "jkanime",
  "name": "JKAnime",
  "version": "1.0.0",
  "description": "Anime subtitulado desde jkanime.net. Home, buscar, biblioteca y ajustes. Sin descubrir.",
  "author": "stormunblessed / adaptado",
  "icon": "https://www.google.com/s2/favicons?domain=jkanime.net&sz=128",
  "iconUrl": "https://www.google.com/s2/favicons?domain=jkanime.net&sz=128",
  "logo": "https://www.google.com/s2/favicons?domain=jkanime.net&sz=128",
  "language": "es",
  "languages": ["es"],
  "types": ["series", "movie"],
  "baseUrl": "https://jkanime.net",
  "entryJs": "jkanime.js",
  "jsFile": "jkanime.js",
  "tabs": ["home", "search", "library", "settings"],
  "capabilities": ["home", "search", "meta", "streams", "library", "settings", "news"],
  "searchImageStyle": "poster",
  "searchShowTitle": true,
  "newsImageStyle": "poster",
  "config": [
    {
      "key": "appendVose",
      "label": "Añadir \"vose\" a cada búsqueda",
      "type": "boolean",
      "defaultValue": "false",
      "description": "Si está activo, después de lo que escribas se añade automáticamente un espacio y la palabra vose. Si está desactivado, se busca exactamente lo que escribes."
    }
  ],
  "catalogs": [
    { "id": "ultimos", "title": "Últimos episodios" },
    { "id": "emision", "title": "En emisión" },
    { "id": "animes", "title": "Animes" },
    { "id": "peliculas", "title": "Películas" }
  ]
}
