{
  "id": "magis-service-catalog",
  "name": "XuperTv",
  "version": "0.1.6",
  "entry": "plugin.js",
  "icon": "icon.png",
  "author": "JostinSantos",
  "description": "Películas, series, anime y doramas en español latino de sololatino.net: géneros, plataformas, búsqueda y varios servidores por título.",
  "color": "#06B6D4",
  "theme": {
    "accent": "#06B6D4",
    "onAccent": "#001418",
    "background": "#070E18",
    "surface": "#0F1B2B",
    "highlight": "#67E8F9"
  },
  "section": {
    "label": "XuperTv"
  },
  "categories": [
    "movies",
    "series"
  ],
  "capabilities": [
    "home",
    "discover",
    "search",
    "meta",
    "streams"
  ],
  "languages": [
    "Latino",
    "Castellano",
    "Subtitulado"
  ],
  "episodesPagination": {
    "enabled": true,
    "perPage": 50
  },
  "config": [
    
    {
      "key": "newsLimit",
      "label": "Máximo de novedades",
      "type": "number",
      "default": "12"
    }
  ]
}
