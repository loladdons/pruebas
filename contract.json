{
  "apiVersion": 6,
  "maxApiVersion": 6,
  "categories": ["movies", "series"],
  "browser": true,
  "telemetry": false,
  "capabilities": {
    "names": ["home", "discover", "search", "meta", "streams"],
    "required": ["home", "streams"],
    "needsApproval": ["browser"]
