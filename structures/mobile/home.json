{
  "id": "home",
  "title": "YouTube",
  "home": true,
  "root": {
    "id": "home_root",
    "type": "scroll",
    "style": {
      "backgroundColor": "#0F0F0F"
    },
    "children": [
      {
        "id": "appbar",
        "type": "container",
        "style": {
          "backgroundColor": "#0F0F0F",
          "padding": {
            "l": 8,
            "r": 12,
            "t": 6,
            "b": 6
          }
        },
        "children": [
          {
            "type": "row",
            "props": {
              "mainAxisAlignment": "spaceBetween",
              "crossAxisAlignment": "center"
            },
            "children": [
              {
                "type": "row",
                "props": {
                  "crossAxisAlignment": "center"
                },
                "children": [
                  {
                    "type": "icon",
                    "props": {
                      "name": "play",
                      "size": 28
                    },
                    "style": {
                      "color": "#FF0000"
                    }
                  },
                  {
                    "type": "spacer",
                    "props": {
                      "width": 8
                    }
                  },
                  {
                    "type": "text",
                    "title": "YouTube Demo",
                    "style": {
                      "fontSize": 18,
                      "fontWeight": "bold",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "type": "row",
                "children": [
                  {
                    "type": "icon",
                    "props": {
                      "name": "search",
                      "size": 24
                    },
                    "style": {
                      "color": "#FFFFFF"
                    }
                  },
                  {
                    "type": "spacer",
                    "props": {
                      "width": 14
                    }
                  },
                  {
                    "type": "avatar",
                    "props": {
                      "size": 30,
                      "url": "https://www.youtube.com/s/desktop/yt_1200.png"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "chips_row",
        "type": "chips",
        "props": {
          "options": [
            "Todo",
            "Música",
            "En directo",
            "Videojuegos",
            "Noticias",
            "Podcasts",
            "Deportes"
          ]
        }
      },
      {
        "id": "hero",
        "type": "hero",
        "props": {
          "height": 200
        },
        "source": "getHome.rows.0.items",
        "style": {
          "borderRadius": 0
        }
      },
      {
        "id": "row_trending",
        "type": "section",
        "title": "Tendencias",
        "source": "getHome.rows.0.items",
        "props": {
          "height": 190,
          "itemWidth": 150,
          "showTitle": true
        }
      },
      {
        "id": "row_music",
        "type": "section",
        "title": "Música y conciertos",
        "source": "getHome.rows.1.items",
        "props": {
          "height": 190,
          "itemWidth": 150,
          "showTitle": true
        }
      },
      {
        "id": "row_docs",
        "type": "section",
        "title": "Documentales",
        "source": "getHome.rows.2.items",
        "props": {
          "height": 190,
          "itemWidth": 150,
          "showTitle": true
        }
      },
      {
        "id": "row_movies",
        "type": "section",
        "title": "Películas y cortos",
        "source": "getHome.rows.3.items",
        "props": {
          "height": 190,
          "itemWidth": 150,
          "showTitle": true
        }
      },
      {
        "type": "spacer",
        "props": {
          "height": 96
        }
      }
    ]
  }
}
