{
  "id": "player",
  "title": "Reproductor",
  "root": {
    "id": "player_root",
    "type": "column",
    "style": { "backgroundColor": "#000000" },
    "children": [
      {
        "id": "video_surface",
        "type": "container",
        "props": { "height": 240 },
        "style": { "backgroundColor": "#000000" },
        "children": [
          {
            "type": "native",
            "native": "player",
            "props": { "fullscreen": false, "controls": true }
          }
        ]
      },
      {
        "type": "container",
        "style": { "backgroundColor": "#0F0F0F", "padding": { "x": 14, "y": 12 } },
        "children": [
          {
            "type": "text",
            "title": "{{title}}",
            "style": { "fontSize": 15, "fontWeight": "bold", "color": "#FFFFFF" },
            "props": { "maxLines": 2 }
          },
          { "type": "spacer", "props": { "height": 6 } },
          {
            "type": "row",
            "children": [
              { "type": "text", "title": "{{channel}}", "style": { "fontSize": 13, "color": "#AAAAAA" } },
              { "type": "spacer", "props": { "width": 10 } },
              { "type": "text", "title": "{{durationClock}}", "style": { "fontSize": 12, "color": "#888888" } }
            ]
          },
          { "type": "spacer", "props": { "height": 12 } },
          {
            "type": "row",
            "props": { "mainAxisAlignment": "spaceEvenly" },
            "children": [
              { "type": "button", "title": "  ▶  Reproducir  ", "props": { "action": "play" } },
              { "type": "button", "title": "  ⛶  Pantalla completa  ", "props": { "action": "fullscreen" } }
            ]
          },
          { "type": "spacer", "props": { "height": 16 } },
          {
            "type": "text",
            "title": "Calidad",
            "style": { "fontSize": 13, "fontWeight": "w600", "color": "#CCCCCC" }
          },
          { "type": "spacer", "props": { "height": 6 } },
          {
            "type": "chips",
            "props": { "options": ["Auto", "1080p", "720p", "480p", "360p"] }
          },
          { "type": "spacer", "props": { "height": 16 } },
          {
            "type": "section",
            "title": "A continuación",
            "source": "related.items",
            "props": { "height": 160, "itemWidth": 140, "showTitle": true }
          }
        ]
      }
    ]
  }
}
