{
  "id": "library",
  "title": "Biblioteca",
  "root": {
    "type": "scroll",
    "style": { "backgroundColor": "#0F0F0F" },
    "children": [
      {
        "type": "container",
        "style": { "padding": { "x": 16, "y": 16 } },
        "children": [
          { "type": "text", "title": "Biblioteca", "style": { "fontSize": 22, "fontWeight": "bold", "color": "#FFFFFF" } },
          { "type": "spacer", "props": { "height": 16 } },
          {
            "type": "section",
            "title": "Continuar viendo",
            "source": "library.continue",
            "props": { "height": 180, "itemWidth": 150, "showTitle": true }
          },
          {
            "type": "section",
            "title": "Favoritos",
            "source": "library.favorites",
            "props": { "height": 180, "itemWidth": 150, "showTitle": true }
          },
          {
            "type": "section",
            "title": "Historial",
            "source": "library.history",
            "props": { "height": 180, "itemWidth": 150, "showTitle": true }
          },
          {
            "type": "emptyState",
            "title": "Tu historial y favoritos aparecerán aquí"
          }
        ]
      }
    ]
  }
}
