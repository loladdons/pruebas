{
  "id": "library",
  "title": "Biblioteca",
  "root": {
    "type": "scroll",
    "style": {
      "backgroundColor": "#0F0F0F"
    },
    "children": [
      {
        "type": "container",
        "style": {
          "padding": {
            "l": 16,
            "r": 16,
            "t": 12,
            "b": 8
          }
        },
        "children": [
          {
            "type": "row",
            "props": {
              "mainAxisAlignment": "spaceBetween",
              "crossAxisAlignment": "center"
            },
            "children": [
              {
                "type": "text",
                "title": "Biblioteca",
                "style": {
                  "fontSize": 22,
                  "fontWeight": "bold",
                  "color": "#FFFFFF"
                }
              },
              {
                "type": "icon",
                "props": {
                  "name": "library",
                  "size": 24
                },
                "style": {
                  "color": "#FF0000"
                }
              }
            ]
          },
          {
            "type": "spacer",
            "props": {
              "height": 16
            }
          },
          {
            "type": "section",
            "title": "Continuar viendo",
            "source": "library.continue",
            "props": {
              "height": 180,
              "itemWidth": 150,
              "showTitle": true
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 8
            }
          },
          {
            "type": "section",
            "title": "Historial",
            "source": "library.history",
            "props": {
              "height": 180,
              "itemWidth": 150,
              "showTitle": true
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 8
            }
          },
          {
            "type": "section",
            "title": "Guardados / Favoritos",
            "source": "library.favorites",
            "props": {
              "height": 180,
              "itemWidth": 150,
              "showTitle": true
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 12
            }
          },
          {
            "type": "text",
            "title": "Reproduce un video para que aparezca en Continuar viendo e Historial.",
            "style": {
              "fontSize": 12,
              "color": "#666666"
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 96
            }
          }
        ]
      }
    ]
  }
}
