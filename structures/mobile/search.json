{
  "id": "search",
  "title": "Buscar",
  "root": {
    "id": "search_root",
    "type": "scroll",
    "style": {
      "backgroundColor": "#0F0F0F"
    },
    "children": [
      {
        "id": "appbar_search",
        "type": "container",
        "style": {
          "backgroundColor": "#0F0F0F",
          "padding": {
            "l": 4,
            "r": 8,
            "t": 4,
            "b": 0
          }
        },
        "children": [
          {
            "type": "row",
            "props": {
              "crossAxisAlignment": "center"
            },
            "children": [
              {
                "type": "icon",
                "props": {
                  "name": "search",
                  "size": 22
                },
                "style": {
                  "color": "#FF0000"
                }
              },
              {
                "type": "spacer",
                "props": {
                  "width": 8
                }
              },
              {
                "type": "text",
                "title": "Buscar",
                "style": {
                  "fontSize": 18,
                  "fontWeight": "bold",
                  "color": "#FFFFFF"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "searchBar",
        "title": "Buscar en YouTube",
        "props": {
          "placeholder": "Buscar vídeos, canales, listas..."
        }
      },
      {
        "id": "search_filters",
        "type": "chips",
        "props": {
          "options": [
            "Vídeos",
            "Canales",
            "Listas",
            "En directo",
            "Cortos"
          ]
        }
      },
      {
        "id": "search_results",
        "type": "list",
        "source": "search.results",
        "props": {
          "showTitle": true
        }
      },
      {
        "id": "search_empty_hint",
        "type": "text",
        "title": "Escribe y pulsa buscar en el teclado",
        "style": {
          "fontSize": 13,
          "color": "#666666"
        }
      },
      {
        "type": "spacer",
        "props": {
          "height": 96
        }
      }
    ]
  }
}
