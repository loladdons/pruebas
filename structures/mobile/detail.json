{
  "id": "detail",
  "title": "Contenido",
  "root": {
    "id": "detail_root",
    "type": "scroll",
    "style": {
      "backgroundColor": "#0F0F0F"
    },
    "children": [
      {
        "id": "player_area",
        "type": "playerEmbed",
        "props": {
          "height": 220
        },
        "style": {
          "backgroundColor": "#000000"
        }
      },
      {
        "id": "info_block",
        "type": "container",
        "style": {
          "padding": {
            "l": 14,
            "r": 14,
            "t": 12,
            "b": 8
          },
          "backgroundColor": "#0F0F0F"
        },
        "children": [
          {
            "type": "text",
            "title": "{{title}}",
            "style": {
              "fontSize": 16,
              "fontWeight": "bold",
              "color": "#FFFFFF"
            },
            "props": {
              "maxLines": 3
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 6
            }
          },
          {
            "type": "text",
            "title": "{{overview}}",
            "style": {
              "fontSize": 13,
              "color": "#AAAAAA"
            },
            "props": {
              "maxLines": 4
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 12
            }
          },
          {
            "type": "row",
            "props": {
              "mainAxisAlignment": "spaceAround"
            },
            "children": [
              {
                "type": "column",
                "props": {
                  "crossAxisAlignment": "center"
                },
                "children": [
                  {
                    "type": "icon",
                    "props": {
                      "name": "star",
                      "size": 22
                    },
                    "style": {
                      "color": "#FFFFFF"
                    }
                  },
                  {
                    "type": "text",
                    "title": "Me gusta",
                    "style": {
                      "fontSize": 11,
                      "color": "#CCCCCC"
                    }
                  }
                ]
              },
              {
                "type": "column",
                "props": {
                  "crossAxisAlignment": "center"
                },
                "children": [
                  {
                    "type": "icon",
                    "props": {
                      "name": "share",
                      "size": 22
                    },
                    "style": {
                      "color": "#FFFFFF"
                    }
                  },
                  {
                    "type": "text",
                    "title": "Compartir",
                    "style": {
                      "fontSize": 11,
                      "color": "#CCCCCC"
                    }
                  }
                ]
              },
              {
                "type": "column",
                "props": {
                  "crossAxisAlignment": "center"
                },
                "children": [
                  {
                    "type": "icon",
                    "props": {
                      "name": "bookmark",
                      "size": 22
                    },
                    "style": {
                      "color": "#FFFFFF"
                    }
                  },
                  {
                    "type": "text",
                    "title": "Guardar",
                    "style": {
                      "fontSize": 11,
                      "color": "#CCCCCC"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "spacer",
            "props": {
              "height": 14
            }
          },
          {
            "type": "button",
            "title": "Reproducir",
            "props": {
              "action": "play"
            },
            "style": {
              "backgroundColor": "#FF0000",
              "color": "#FFFFFF",
              "borderRadius": 22
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 10
            }
          },
          {
            "type": "button",
            "title": "Abrir player original de la app",
            "props": {
              "action": "play"
            },
            "style": {
              "backgroundColor": "#212121",
              "color": "#FFFFFF",
              "borderRadius": 22
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 16
            }
          },
          {
            "type": "container",
            "style": {
              "backgroundColor": "#212121",
              "borderRadius": 12,
              "padding": {
                "x": 12,
                "y": 10
              }
            },
            "children": [
              {
                "type": "text",
                "title": "{{overview}}",
                "style": {
                  "fontSize": 13,
                  "color": "#DDDDDD"
                },
                "props": {
                  "maxLines": 10
                }
              }
            ]
          },
          {
            "type": "spacer",
            "props": {
              "height": 18
            }
          },
          {
            "type": "text",
            "title": "Relacionados",
            "style": {
              "fontSize": 16,
              "fontWeight": "bold",
              "color": "#FFFFFF"
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 8
            }
          },
          {
            "id": "related",
            "type": "list",
            "source": "related.items",
            "props": {
              "showTitle": true
            }
          },
          {
            "type": "spacer",
            "props": {
              "height": 40
            }
          }
        ]
      }
    ]
  }
}
