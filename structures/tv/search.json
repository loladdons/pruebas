{
  "id": "search",
  "title": "Buscar",
  "root": {
    "type": "column",
    "style": { "backgroundColor": "#0F0F0F" },
    "children": [
      {
        "type": "searchBar",
        "title": "Buscar en YouTube",
        "props": { "placeholder": "Buscar vídeos, canales, listas..." }
      },
      {
        "type": "chips",
        "props": { "options": ["Vídeos", "Canales", "Listas", "En directo"] }
      },
      {
        "type": "grid",
        "source": "search.results",
        "props": { "columns": 5, "aspectRatio": 1.4, "showTitle": true }
      },
      {
        "type": "emptyState",
        "title": "Usa el teclado para buscar"
      }
    ]
  }
}
