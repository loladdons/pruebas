{
  "id": "detail",
  "title": "Contenido",
  "root": {
    "type": "row",
    "style": { "backgroundColor": "#0F0F0F" },
    "children": [
      {
        "type": "column",
        "props": { "flex": 2 },
        "children": [
          {
            "type": "container",
            "props": { "height": 420 },
            "style": { "backgroundColor": "#000000" },
            "children": [
              {
                "type": "native",
                "native": "player",
                "props": { "controls": true }
              }
            ]
          },
          {
            "type": "container",
            "style": { "padding": { "x": 24, "y": 16 } },
            "children": [
              {
                "type": "text",
                "title": "{{title}}",
                "style": { "fontSize": 22, "fontWeight": "bold", "color": "#FFFFFF" },
                "props": { "maxLines": 2 }
              },
              { "type": "spacer", "props": { "height": 8 } },
              {
                "type": "row",
                "children": [
                  { "type": "text", "title": "{{channel}}", "style": { "fontSize": 14, "color": "#CCCCCC" } },
                  { "type": "spacer", "props": { "width": 16 } },
                  { "type": "text", "title": "{{viewsText}} vistas · {{publishedText}}", "style": { "fontSize": 13, "color": "#888888" } }
                ]
              },
              { "type": "spacer", "props": { "height": 12 } },
              {
                "type": "container",
                "style": { "backgroundColor": "#212121", "borderRadius": 12, "padding": { "x": 14, "y": 12 } },
                "children": [
                  {
                    "type": "text",
                    "title": "{{overview}}",
                    "style": { "fontSize": 14, "color": "#DDDDDD" },
                    "props": { "maxLines": 6 }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "column",
        "props": { "flex": 1 },
        "style": { "backgroundColor": "#121212" },
        "children": [
          {
            "type": "container",
            "style": { "padding": { "x": 16, "y": 16 } },
            "children": [
              { "type": "text", "title": "A continuación", "style": { "fontSize": 16, "fontWeight": "bold", "color": "#FFFFFF" } },
              { "type": "spacer", "props": { "height": 12 } },
              {
                "type": "list",
                "source": "related.items",
                "props": { "showTitle": true }
              }
            ]
          }
        ]
      }
    ]
  }
}
