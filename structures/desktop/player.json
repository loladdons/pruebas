{
  "id": "player",
  "title": "Reproductor",
  "root": {
    "type": "column",
    "style": { "backgroundColor": "#000000" },
    "children": [
      {
        "type": "container",
        "props": { "height": 520 },
        "children": [
          { "type": "native", "native": "player", "props": { "controls": true, "fullscreen": false } }
        ]
      },
      {
        "type": "container",
        "style": { "backgroundColor": "#0F0F0F", "padding": { "x": 20, "y": 14 } },
        "children": [
          {
            "type": "text",
            "title": "{{title}}",
            "style": { "fontSize": 16, "fontWeight": "bold", "color": "#FFFFFF" },
            "props": { "maxLines": 2 }
          },
          { "type": "spacer", "props": { "height": 6 } },
          {
            "type": "row",
            "children": [
              { "type": "text", "title": "{{channel}}", "style": { "fontSize": 13, "color": "#AAAAAA" } },
              { "type": "spacer", "props": { "width": 16 } },
              { "type": "chips", "props": { "options": ["Auto", "1080p", "720p", "480p"] } }
            ]
          }
        ]
      }
    ]
  }
}
