{
  "id": "search",
  "title": "Buscar",
  "root": {
    "type": "column",
    "style": { "backgroundColor": "#0F0F0F" },
    "children": [
      {
        "type": "container",
        "style": { "padding": { "x": 32, "y": 16 } },
        "children": [
          {
            "type": "searchBar",
            "props": { "placeholder": "Buscar vídeos, canales y listas de YouTube..." }
          }
        ]
      },
      {
        "type": "chips",
        "props": { "options": ["Vídeos", "Canales", "Listas", "En directo", "Cortos"] }
      },
      {
        "type": "grid",
        "source": "search.results",
        "props": { "columns": 4, "aspectRatio": 1.35, "showTitle": true }
      },
      {
        "type": "emptyState",
        "title": "Busca algo para empezar"
      }
    ]
  }
}
