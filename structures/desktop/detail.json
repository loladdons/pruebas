{
  "id": "detail",
  "title": "Contenido",
  "root": {
    "type": "row",
    "style": { "backgroundColor": "#0F0F0F" },
    "children": [
      {
        "type": "column",
        "props": { "flex": 7 },
        "children": [
          {
            "type": "container",
            "props": { "height": 480 },
            "style": { "backgroundColor": "#000000" },
            "children": [
              { "type": "native", "native": "player", "props": { "controls": true } }
            ]
          },
          {
            "type": "container",
            "style": { "padding": { "x": 20, "y": 16 } },
            "children": [
              {
                "type": "text",
                "title": "{{title}}",
                "style": { "fontSize": 20, "fontWeight": "bold", "color": "#FFFFFF" },
                "props": { "maxLines": 2 }
              },
              { "type": "spacer", "props": { "height": 8 } },
              {
                "type": "row",
                "props": { "mainAxisAlignment": "spaceBetween" },
                "children": [
                  {
                    "type": "row",
                    "children": [
                      { "type": "avatar", "props": { "size": 44 } },
                      { "type": "spacer", "props": { "width": 12 } },
                      {
                        "type": "column",
                        "children": [
                          { "type": "text", "title": "{{channel}}", "style": { "fontSize": 14, "fontWeight": "w600", "color": "#FFFFFF" } },
                          { "type": "text", "title": "{{viewsText}} vistas · {{publishedText}}", "style": { "fontSize": 12, "color": "#AAAAAA" } }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "children": [
                      { "type": "button", "title": "Me gusta", "props": { "action": "like" } },
                      { "type": "spacer", "props": { "width": 8 } },
                      { "type": "button", "title": "Compartir", "props": { "action": "share" } },
                      { "type": "spacer", "props": { "width": 8 } },
                      { "type": "button", "title": "Guardar", "props": { "action": "save" } }
                    ]
                  }
                ]
              },
              { "type": "spacer", "props": { "height": 14 } },
              {
                "type": "container",
                "style": { "backgroundColor": "#212121", "borderRadius": 12, "padding": { "x": 14, "y": 12 } },
                "children": [
                  {
                    "type": "text",
                    "title": "{{overview}}",
                    "style": { "fontSize": 13, "color": "#DDDDDD" },
                    "props": { "maxLines": 10 }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "column",
        "props": { "flex": 3 },
        "style": { "backgroundColor": "#121212" },
        "children": [
          {
            "type": "container",
            "style": { "padding": { "x": 12, "y": 16 } },
            "children": [
              { "type": "text", "title": "A continuación", "style": { "fontSize": 15, "fontWeight": "bold", "color": "#FFFFFF" } },
              { "type": "spacer", "props": { "height": 10 } },
              {
                "type": "list",
                "source": "related.items",
                "props": { "showTitle": true }
              }
            ]
          }
        ]
      }
    ]
  }
}
